#!/usr/bin/env bash
# Local build gate. CI no longer runs auto full builds (Actions cost); the mandatory
# build gate is this LOCAL incremental build. Blocks push unless grep guards pass and
# (when Lean sources changed) the incremental build is green.
# Enable once per clone:  git config core.hooksPath scripts/hooks
set -uo pipefail
ROOT="$(git rev-parse --show-toplevel)" || exit 1
cd "$ROOT" || exit 1

# Environment hygiene: when git invokes this hook from a *linked worktree* it exports the
# invoking repo's local env vars (GIT_DIR/GIT_COMMON_DIR/GIT_WORK_TREE/…), absolute and
# pointing at THIS repo. `lake` inherits them, so every git subprocess it spawns inside
# .lake/packages/mathlib queries THIS repo instead of the mathlib package repo — lake then
# sees a "changed URL", deletes the ~6.3G prebuilt mathlib package and re-clones (which
# itself fails on the leaked dir). Clear the complete repo-local set (git's own recommended
# way to operate in a foreign repo — git-scm hooks docs) now, after $ROOT is resolved: the
# rest of the hook rediscovers the repo from $ROOT (correct for both main clone and
# worktree), and lake's subprocesses resolve their own repos. GIT_COMMON_DIR in particular
# leaks the origin URL identically, so a partial list is insufficient. (#196; PR #197 review.)
# shellcheck disable=SC2046  # deliberate word-split: unset each name git reports
unset $(git rev-parse --local-env-vars)

# Serialized incremental build. flock(1) is util-linux and absent on macOS (#118),
# so fall back to the same kernel flock(2) via perl there (macOS ships /usr/bin/perl;
# the exec'd build inherits the locked fd, so the lock lives exactly as long as the
# build — no lock files to reclaim, no stale/PID-reuse states, no cleanup traps).
# The Linux flock path is unchanged.
run_build_locked() {
  if command -v flock >/dev/null 2>&1; then
    flock /tmp/lean-build.lock lake build
  elif command -v perl >/dev/null 2>&1; then
    perl -e '
      use Fcntl qw(:flock F_SETFD);
      open(my $fh, ">>", "/tmp/lean-build.lock") or die "pre-push lock open: $!\n";
      flock($fh, LOCK_EX)                        or die "pre-push flock: $!\n";
      fcntl($fh, F_SETFD, 0)                     or die "pre-push fcntl: $!\n";
      exec @ARGV or die "pre-push exec: $!\n";
    ' lake build
  else
    # mirrors scripts/agent-preflight.sh: better an unserialized build than no gate
    # (warning is emitted at the call site — this function's stderr goes to $LOG)
    lake build
  fi
}

echo "[pre-push] grep guards…"
bash scripts/check-no-sorry.sh      || { echo "[pre-push] BLOCK: check-no-sorry failed";      exit 1; }
bash scripts/check-no-axiom.sh      || { echo "[pre-push] BLOCK: check-no-axiom failed";      exit 1; }
bash scripts/check-theorem-names.sh || { echo "[pre-push] BLOCK: check-theorem-names failed"; exit 1; }

# Collect the set of changed files from the refs git supplies on stdin
# (format: <local-ref> <local-oid> <remote-ref> <remote-oid>).
# Fallback to HEAD-vs-origin/main when stdin is empty (manual invocation).
z40="0000000000000000000000000000000000000000"
changed=""
had_input=0
while read -r local_ref local_oid remote_ref remote_oid; do
  had_input=1
  [ -z "${local_oid:-}" ] && continue
  [ "$local_oid" = "$z40" ] && continue                     # deleting a ref — nothing to build
  if [ "$remote_oid" = "$z40" ]; then                       # new remote branch
    rbase="$(git merge-base "$local_oid" origin/main 2>/dev/null || true)"
  else
    rbase="$remote_oid"
  fi
  if [ -n "${rbase:-}" ]; then
    changed+="$(git diff --name-only "$rbase" "$local_oid" 2>/dev/null)"$'\n'
  else
    changed+="$(git diff --name-only "$local_oid" 2>/dev/null)"$'\n'
  fi
done
if [ "$had_input" = "0" ]; then
  base="$(git merge-base HEAD origin/main 2>/dev/null || true)"
  changed="$(git diff --name-only "${base:-HEAD}" HEAD 2>/dev/null || true)"
fi
if printf '%s\n' "$changed" | grep -qE '\.lean$|lakefile|lean-toolchain|lake-manifest'; then
  echo "[pre-push] Lean sources changed — incremental build (serialized)…"
  if ! command -v flock >/dev/null 2>&1 && ! command -v perl >/dev/null 2>&1; then
    echo "[pre-push] WARNING: neither flock nor perl found; running lake build without serialization lock." >&2
  fi
  LOG="$(mktemp)"
  if ! run_build_locked >"$LOG" 2>&1; then
    echo "[pre-push] BLOCK: lake build FAILED. Tail:"; tail -n 30 "$LOG"; rm -f "$LOG"; exit 1
  fi
  rm -f "$LOG"
  echo "[pre-push] build green"
else
  echo "[pre-push] no Lean/build changes — skipping build"
fi
echo "[pre-push] gate passed"
exit 0
